<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AppBackgroundColor">#F8FAFC</Color>
          <Color x:Key="PanelBackgroundColor">#FFFFFF</Color>
          <Color x:Key="PanelRaisedColor">#F1F5F9</Color>
          <Color x:Key="TextPrimaryColor">#1E293B</Color>
          <Color x:Key="TextSecondaryColor">#64748B</Color>
          <Color x:Key="BorderColor">#E2E8F0</Color>
          <Color x:Key="TrackBedColor">#E2E8F0</Color>
          <Color x:Key="RailColor">#5F6873</Color>
          <Color x:Key="SignalGreenColor">#22C55E</Color>
          <Color x:Key="SignalYellowColor">#EAB308</Color>
          <Color x:Key="SignalRedColor">#EF4444</Color>
          <Color x:Key="AccentColor">#0EA5E9</Color>
          <Color x:Key="AccentStrongColor">#0284C7</Color>
          <Color x:Key="TrackPlanRailColor">#5F6873</Color>
          <Color x:Key="TrackPlanRouteHighlightColor">#0EA5E9</Color>
          <Color x:Key="TrackPlanSymbolBorderColor">#64748B</Color>
          <Color x:Key="TrackPlanSymbolSelectedBorderColor">#0284C7</Color>
          <Color x:Key="TrackPlanSymbolTextColor">#111827</Color>
          <Color x:Key="TrackPlanSignalColor">Red</Color>
          <Color x:Key="TrackPlanZwergSignalGreenColor">#90EE90</Color>
          <Color x:Key="TrackPlanZwergSignalRedColor">#FCA5A5</Color>
          <Color x:Key="TrackPlanSwitchColor">Blue</Color>
          <Color x:Key="TrackPlanDoubleSlipSwitchColor">LightBlue</Color>
          <Color x:Key="TrackPlanBlockColor">Yellow</Color>
          <Color x:Key="TrackPlanAccessoryColor">#E2E8F0</Color>
          <Color x:Key="TrackPlanStructureColor">#C4B5FD</Color>
          <Color x:Key="TrackPlanSafetyColor">#FCA5A5</Color>
          <Color x:Key="TrackPlanDefaultSymbolColor">#F8FAFC</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AppBackgroundColor">#0F172A</Color>
          <Color x:Key="PanelBackgroundColor">#1E293B</Color>
          <Color x:Key="PanelRaisedColor">#334155</Color>
          <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
          <Color x:Key="TextSecondaryColor">#94A3B8</Color>
          <Color x:Key="BorderColor">#334155</Color>
          <Color x:Key="TrackBedColor">#334155</Color>
          <Color x:Key="RailColor">#9AA7B5</Color>
          <Color x:Key="SignalGreenColor">#4ADE80</Color>
          <Color x:Key="SignalYellowColor">#FACC15</Color>
          <Color x:Key="SignalRedColor">#F87171</Color>
          <Color x:Key="AccentColor">#38BDF8</Color>
          <Color x:Key="AccentStrongColor">#7DD3FC</Color>
          <Color x:Key="TrackPlanRailColor">#9AA7B5</Color>
          <Color x:Key="TrackPlanRouteHighlightColor">#38BDF8</Color>
          <Color x:Key="TrackPlanSymbolBorderColor">#41546A</Color>
          <Color x:Key="TrackPlanSymbolSelectedBorderColor">#7DD3FC</Color>
          <Color x:Key="TrackPlanSymbolTextColor">#0F172A</Color>
          <Color x:Key="TrackPlanSignalColor">Red</Color>
          <Color x:Key="TrackPlanZwergSignalGreenColor">#4ADE80</Color>
          <Color x:Key="TrackPlanZwergSignalRedColor">Green</Color>
          <Color x:Key="TrackPlanSwitchColor">Blue</Color>
          <Color x:Key="TrackPlanDoubleSlipSwitchColor">LightBlue</Color>
          <Color x:Key="TrackPlanBlockColor">Yellow</Color>
          <Color x:Key="TrackPlanAccessoryColor">#94A3B8</Color>
          <Color x:Key="TrackPlanStructureColor">#A78BFA</Color>
          <Color x:Key="TrackPlanSafetyColor">#F87171</Color>
          <Color x:Key="TrackPlanDefaultSymbolColor">#CBD5E1</Color>
        </ResourceDictionary>
        
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" />
      <SolidColorBrush x:Key="PanelRaisedBrush" Color="{DynamicResource PanelRaisedColor}" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
      <SolidColorBrush x:Key="TrackBedBrush" Color="{DynamicResource TrackBedColor}" />
      <SolidColorBrush x:Key="RailBrush" Color="{DynamicResource RailColor}" />
      <SolidColorBrush x:Key="SignalGreenBrush" Color="{DynamicResource SignalGreenColor}" />
      <SolidColorBrush x:Key="SignalYellowBrush" Color="{DynamicResource SignalYellowColor}" />
      <SolidColorBrush x:Key="SignalRedBrush" Color="{DynamicResource SignalRedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="{DynamicResource AccentStrongColor}" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Border.rail-surface">
    <Setter Property="Background" Value="{DynamicResource TrackBedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
  </Style>

  <Style Selector="Button.tool">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
</Styles>
