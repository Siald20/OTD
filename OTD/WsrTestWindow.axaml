<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OTD.WsrTestWindow"
        Title="WSR-Test"
        Width="1050"
        Height="650"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16"
          ColumnDefinitions="320,260,*"
          RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.ColumnSpan="3"
                   Text="TMN500 WSR testen"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12"
                        Margin="0,0,18,0">
                <TextBlock Text="Eingänge"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <CheckBox x:Name="IsFreeCheckBox"
                          Content="Isolierung frei (i_IS)"
                          IsChecked="True"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="WsrButtonCheckBox"
                          Content="Weichentaste gedrückt (t_WT)"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="RemoteWsrButtonCheckBox"
                          Content="Fernsteuerung Weichentaste (tfu_WT)"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="EnableWsrButtonCheckBox"
                          Content="Weichentaste freigegeben (sl_TR_W)"
                          IsChecked="True"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="EvOnCheckBox"
                          Content="EV einschalten (sl_EV_E)"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="EvOffCheckBox"
                          Content="EV ausschalten (sl_EV_A)"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="AmPermissionCheckBox"
                          Content="AM-Gruppentaste (sl_AM_GT)"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="StPermissionCheckBox"
                          Content="ST-Gruppentaste (sl_ST_GT)"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="WiuPermissionCheckBox"
                          Content="WIU-Gruppentaste (sl_WIU_GT)"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="IndicatorCheckBox"
                          Content="Meldeleuchten aktiv (sl_ML)"
                          IsChecked="True"
                          IsCheckedChanged="InputChanged" />
                <CheckBox x:Name="ForceWvCheckBox"
                          Content="Weichenverschluss simulieren (WV)"
                          IsCheckedChanged="InputChanged" />

                <Separator Margin="0,4" />

                <TextBlock Text="Weichenantrieb"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Direkter Funktionstest ohne WSR-Steuerung."
                           FontSize="12" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Links"
                            MinWidth="90"
                            Click="MoveSwitchLeft" />
                    <Button Content="Stopp"
                            MinWidth="90"
                            Click="StopSwitch" />
                    <Button Content="Rechts"
                            MinWidth="90"
                            Click="MoveSwitchRight" />
                </StackPanel>
                <TextBlock x:Name="SwitchPositionText"
                           Text="Position: rechts" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.Column="1"
                BorderBrush="#B8B8B8"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,12,0">
            <StackPanel Spacing="12">
                <TextBlock Text="Lampentafel"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="Weichenverschluss"
                               VerticalAlignment="Center" />
                    <Ellipse x:Name="WvLamp"
                             Grid.Column="1"
                             Width="22"
                             Height="22"
                             Fill="#303030" />

                    <TextBlock Grid.Row="1"
                               Text="Spitze"
                               VerticalAlignment="Center" />
                    <Ellipse x:Name="TipWhiteLamp"
                             Grid.Row="1"
                             Grid.Column="1"
                             Width="22"
                             Height="22"
                             Fill="#303030" />
                    <Ellipse x:Name="TipRedLamp"
                             Grid.Row="1"
                             Grid.Column="2"
                             Width="22"
                             Height="22"
                             Margin="8,0,0,0"
                             Fill="#303030" />

                    <TextBlock Grid.Row="2"
                               Text="Links"
                               VerticalAlignment="Center" />
                    <Ellipse x:Name="LeftWhiteLamp"
                             Grid.Row="2"
                             Grid.Column="1"
                             Width="22"
                             Height="22"
                             Fill="#303030" />
                    <Ellipse x:Name="LeftRedLamp"
                             Grid.Row="2"
                             Grid.Column="2"
                             Width="22"
                             Height="22"
                             Margin="8,0,0,0"
                             Fill="#303030" />

                    <TextBlock Grid.Row="3"
                               Text="Rechts"
                               VerticalAlignment="Center" />
                    <Ellipse x:Name="RightWhiteLamp"
                             Grid.Row="3"
                             Grid.Column="1"
                             Width="22"
                             Height="22"
                             Fill="#303030" />
                    <Ellipse x:Name="RightRedLamp"
                             Grid.Row="3"
                             Grid.Column="2"
                             Width="22"
                             Height="22"
                             Margin="8,0,0,0"
                             Fill="#303030" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="weiß"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="rot"
                               FontSize="11"
                               Margin="8,0,0,0"
                               HorizontalAlignment="Center" />
                </Grid>

                <TextBlock Text="Links/Rechts zeigen die Lage ohne Weichenverschluss. Die weiße Spitzenanzeige benötigt zusätzlich den simulierten Weichenverschluss."
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="2"
                BorderBrush="#B8B8B8"
                BorderThickness="1"
                Padding="14">
            <ScrollViewer>
                <TextBlock x:Name="StateText"
                           FontFamily="Consolas"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2"
              Grid.ColumnSpan="3"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Margin="0,14,0,0">
            <Button Content="Ein Schritt"
                    MinWidth="110"
                    Click="RunOneStep" />
            <Button Grid.Column="1"
                    Content="10 Schritte"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Click="RunTenSteps" />
            <Button Grid.Column="2"
                    Content="Zurücksetzen"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Click="ResetTest" />
            <TextBlock x:Name="CycleText"
                       Grid.Column="4"
                       Text="Zyklus: 0"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
