<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OTD.Controls.InterlockingEnlements.SignalTiles">

    <UserControl.Styles>
        <StyleInclude Source="avares://OTD/Controls/InterlockingEnlements/SingalTiles/Styles/SignalTilesStyles.axaml" />
    </UserControl.Styles>
    
    <!-- DO69 Hauptsignal 3 Linsig -->
    
    <Border Classes="tile"
            Width="120"
            Height="120">
        <Canvas Width="120"
                Height="120">
            <Rectangle Canvas.Top="60" Width="120" Height="14" Fill="{StaticResource GleisDunkel}"/>
            
            <Grid Canvas.Left="50"
                  Canvas.Top="20"
                  Width="52"
                  Height="16">
                <Polygon Points="3,0 49,0 52,3 52,13 49,16 3,16 0,13 0,3"
                         Fill="#111" />
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Rectangle Width="8" Height="8" Fill="{StaticResource LampOff}"/>
                    <Rectangle Width="8" Height="8" Fill="{StaticResource SignalRed}"/>
                    <Rectangle Width="8" Height="8" Fill="{StaticResource SignalGreen}"/>
                </StackPanel>
            </Grid>
            
            <Grid x:Name="MemoryGroup"
                  Canvas.Left="50"
                  Canvas.Top="54"
                  Width="28"
                  Height="28">
                <Ellipse x:Name="StorageRing"
                         Classes="memory-ring"
                         Width="28"
                         Height="28"
                         Fill="Transparent"
                         StrokeThickness="4"/>
                <Button x:Name="MemoryButton"
                        Width="22"
                        Height="22"
                        CornerRadius="0"
                        Classes="signal-button-storage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Grid>
            <Button x:Name="NoMemoryButton"
                    Canvas.Left="50"
                    Canvas.Top="40"
                    Width="24"
                    Height="24"
                    CornerRadius="0"
                    Classes="signal-button"
                    IsVisible="False"/>
            <TextBlock x:Name="SignalNameText"
                       Canvas.Left="40"
                       Canvas.Top="80"
                       Width="48"
                       Text="xxx"
                       TextAlignment="Center"
                       FontWeight="Bold" />
        </Canvas>
    </Border>
    

</UserControl>
