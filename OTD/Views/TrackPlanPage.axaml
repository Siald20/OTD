<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="960"
             d:DesignHeight="640"
             x:Class="OTD.Views.TrackPlanPage">
    
    <Grid RowDefinitions="Auto,*"
          Background="{DynamicResource AppBackgroundBrush}">
        <DockPanel Grid.Row="0">
            <Menu DockPanel.Dock="Top">
            <MenuItem Header="OTD">
                <MenuItem Header="_Zurueck"
                          Click="BackToMain_OnClick"/>
                <Separator/>
                <MenuItem Header="_Einstellungen"
                          Click="OpenSettings"/>
                <MenuItem Header="Beenden"
                          InputGesture="Ctrl+Q"/>
            </MenuItem>
          
            <MenuItem Header="Bearbeiten">
                <MenuItem Header="Gleisplan"/>
            </MenuItem>
        </Menu>
        </DockPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="270,*"
              Margin="16"
              ColumnSpacing="16">
            <Border Classes="panel"
                    Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gleisplan"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Editor und Bedienebene fuer den Anlagenbetrieb"
                                   Classes="secondary"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Button x:Name="EditorModeButton"
                                Classes="primary"
                                Content="Editor"
                                Click="SetEditorMode_OnClick" />
                        <Button x:Name="OperationModeButton"
                                Grid.Column="1"
                                Classes="tool"
                                Content="Bedienung"
                                Click="SetOperationMode_OnClick" />
                    </Grid>

                    <StackPanel x:Name="EditorPanel"
                                Spacing="8">
                        <TextBlock Text="Elemente"
                                   FontWeight="SemiBold" />
                        <Button Classes="primary"
                                Content="XML speichern"
                                Click="SaveXml_OnClick" />
                        <Button Classes="tool"
                                Content="Demo laden"
                                Click="LoadDemoTrackPlan_OnClick" />
                        <ScrollViewer MaxHeight="260">
                            <WrapPanel x:Name="ElementPalette"
                                       ItemWidth="106"
                                       ItemHeight="72" />
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel x:Name="OperationPanel"
                                Spacing="8"
                                IsVisible="False">
                        <TextBlock Text="Bedienung"
                                   FontWeight="SemiBold" />
                        <Button Classes="primary"
                                Content="Fahrstrassen berechnen"
                                Click="FindAllRoutes_OnClick" />
                        <ListBox x:Name="OperationRouteList"
                                 Height="150"
                                 SelectionChanged="OperationRouteList_OnSelectionChanged" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button Classes="primary"
                                    Content="Stellen"
                                    Click="SetRoute_OnClick" />
                            <Button Grid.Column="1"
                                    Classes="tool"
                                    Content="Aufloesen"
                                    Click="ReleaseRoute_OnClick" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button Classes="tool"
                                    Content="Block belegen"
                                    Click="ToggleSelectedBlock_OnClick" />
                            <Button Grid.Column="1"
                                    Classes="tool"
                                    Content="Not-Halt"
                                    Click="EmergencyStop_OnClick" />
                        </Grid>
                        <TextBlock x:Name="ActiveRouteText"
                                   Text="Keine Fahrstrasse aktiv."
                                   Classes="secondary"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="EditorAutomationPanel"
                                Spacing="8">
                        <TextBlock Text="Automatik"
                                   FontWeight="SemiBold" />
                        <Button Classes="primary"
                                Content="Fahrstrasse suchen"
                                Click="FindRoute_OnClick" />
                        <Button Classes="tool"
                                Content="Alle Fahrstrassen"
                                Click="FindAllRoutes_OnClick" />
                        <ListBox x:Name="RouteList"
                                 Height="150"
                                 SelectionChanged="RouteList_OnSelectionChanged" />
                    </StackPanel>

                    <Border Classes="rail-surface"
                            Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Status"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="TrackPlanStatus"
                                       Text="Demo laden oder Werkzeug waehlen."
                                       Classes="secondary"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Classes="rail-surface"
                    Padding="12">
                <Canvas x:Name="TrackCanvas"
                        Background="{DynamicResource TrackBedBrush}"
                        PointerPressed="TrackCanvas_OnPointerPressed"
                        ClipToBounds="True" />
            </Border>
        </Grid>
    </Grid>
    
</UserControl>
