<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="760"
             x:Class="OTD.Views.TrackPlanPage">

    <Grid ColumnDefinitions="320,*"
          Margin="16"
          ColumnSpacing="16"
          Background="{DynamicResource StellwerkGreen}">
        <Border Classes="panel"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <TextBlock Text="Trackplan Editor"
                               FontSize="22"
                               FontWeight="SemiBold" />

                    <TextBlock Text="Elemente"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          Height="270">
                        <ListBox x:Name="SymbolCategoryTabs"
                                 Width="110"
                                 SelectionChanged="SymbolCategoryTabs_OnSelectionChanged">
                            <ListBoxItem Content="SignalTiles" Tag="signaltiles" />
                            <ListBoxItem Content="Weitere" Tag="more" />
                        </ListBox>
                        <Border Grid.Column="1"
                                Classes="rail-surface"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="ElementPalette"
                                           ItemWidth="118"
                                           ItemHeight="118" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <TextBlock Text="Raster"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="GridColumnsText"
                               Text="Spalten: 20"
                               Classes="secondary" />
                    <Slider x:Name="GridColumnsSlider"
                            Minimum="6"
                            Maximum="200"
                            Value="20"
                            TickFrequency="1"
                            ValueChanged="GridColumnsSlider_OnValueChanged" />

                    <TextBlock x:Name="GridRowsText"
                               Text="Zeilen: 12"
                               Classes="secondary" />
                    <Slider x:Name="GridRowsSlider"
                            Minimum="4"
                            Maximum="120"
                            Value="12"
                            TickFrequency="1"
                            ValueChanged="GridRowsSlider_OnValueChanged" />

                    <TextBlock x:Name="CellSizeText"
                               Text="Zellgroesse: 120"
                               Classes="secondary" />
                    <Slider x:Name="CellSizeSlider"
                            Minimum="120"
                            Maximum="120"
                            Value="120"
                            TickFrequency="1"
                            ValueChanged="CellSizeSlider_OnValueChanged" />

                    <TextBlock x:Name="GridZoomText"
                               Text="Zoom: 100%"
                               Classes="secondary" />
                    <Slider x:Name="GridZoomSlider"
                            Minimum="50"
                            Maximum="250"
                            Value="100"
                            TickFrequency="5"
                            ValueChanged="GridZoomSlider_OnValueChanged" />

                    <Border Classes="rail-surface"
                            Padding="10"
                            Margin="0,8,0,0">
                        <TextBlock x:Name="TrackPlanStatus"
                                   Text="Symbol auswaehlen und per Drag-and-Drop platzieren."
                                   Classes="secondary"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1"
                Classes="rail-surface"
                Padding="12">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="8">
                <TextBlock Text="Platzierungsraster"
                           FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1"
                              x:Name="PlacementScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="True"
                              KeyDown="PlacementScrollViewer_OnKeyDown"
                              PointerWheelChanged="PlacementScrollViewer_OnPointerWheelChanged">
                    <Border x:Name="PlacementZoomHost"
                            Background="{DynamicResource StellwerkGreen}"
                            Padding="8">
                        <Grid x:Name="SymbolPlacementGrid"
                              UseLayoutRounding="True"
                              ClipToBounds="True" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
