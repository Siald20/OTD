<!-- Definition of Switching Devices like Turnouts and Signals -->
<accessories>
    <!-- Normale Weiche mit einem Antrieb (Basis-Protokoll, Aktivierungszeit 500 ms) -->
    <accessory uid="3f8a1b2c-4d5e-4f7a-8b9c-0d1e2f3a4b5c" type="turnout" subtype="left" interlocking="Bi" name="W1" >
        <decoder>
            <protocol>DCC</protocol>
            <activationtime>500</activationtime>
        </decoder>
        <states>
            <state name="straight" description="gerade">
                <decoder address="11" outputvalue="1" />
            </state>
            <state name="diverging" description="abzweigend">
                <decoder address="11" outputvalue="0"/>
            </state>
        </states>
    </accessory>
    <!-- Doppelkreuzungsweiche mit zwei Antrieben (Basis-Protokoll, Aktivierungszeit 500 ms, Pause zwischen Schaltvorgängen 1000 ms) -->
    <accessory uid="4a9b2c3d-5e6f-4a7b-9c0d-1e2f3a4b5c6d" type="turnout" subtype="double-slip" interlocking="Bi" name="W2" >
        <decoder>
            <protocol>DCC</protocol>
            <activationtime>500</activationtime>
        </decoder>
        <states>
            <state name="straight" description="gerade über Hauptgleis">
                <decoder address="9" outputvalue="1"/>
                <decoder address="10" outputvalue="1"/>
            </state>
            <state name="straight-crossing" description="abzweigend vom Hauptgleis auf überkreuzendes Gleis">
                <decoder address="9" outputvalue="1"/>
                <decoder address="10" outputvalue="0"/>
            </state>
            <state name="crossing" description="gerade über überkreuzendes Gleis">
                <decoder address="9" outputvalue="0"/>
                <decoder address="10" outputvalue="0"/>
            </state>
            <state name="crossing-straight" description="abzweigend vom überkreuzendem Gleis auf Hauptgleis">
                <decoder address="9" outputvalue="0"/>
                <decoder address="10" outputvalue="1"/>
            </state>
        </states>
    </accessory>
