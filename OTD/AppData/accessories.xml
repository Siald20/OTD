    <!-- Signal Typ SBB-L (Basis-Protokoll, Aktivierungszeit 500 ms, keine Pause zwischen Schaltvorgängen) -->
    <!-- Die Idee wäre, die beiden Ausgänge bei Adresse 203 alternativ für Hilfssignal/Besetzte Einfahrt zu nutzen
     mit der aktuell programmierten "Flip-Flop" Funktion bei Dauerschaltung lassn sich jedoch nicht beide ausschalten.
     Das muss noch gefixt werden (und auch am Decoder getestet werden, ob überhaupt so möglich) -->
    <accessory uid="b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e" type="signal" subtype="SBB-L" name="S1" interlocking="Bi" >
        <model>
            <signalsystem>SBB-L</signalsystem>
            <notes>Hauptsignal SBB Typ L</notes>
        </model>
        <decoder>
            <protocol>DCC</protocol>
        </decoder>
        <states>
            <state name="Halt" description="Halt">
                <decoder address="200" outputvalue="0"/>
                <decoder address="201" outputvalue="0"/>
                <decoder address="202" outputvalue="0"/>
            </state>
            <state name="Im1" description="Freie Fahrt">
                <decoder address="200" outputvalue="1"/>
                <decoder address="201" outputvalue="0"/>
                <decoder address="202" outputvalue="0"/>
            </state>
            <state name="Im2" description="Fahrbegriff 2 (40 km/h)">
                <decoder address="200" outputvalue="1"/>
                <decoder address="201" outputvalue="1"/>
                <decoder address="202" outputvalue="0"/>
            </state>
            <state name="Im3" description="Fahrbegriff 3 (60 km/h)">
                <decoder address="200" outputvalue="1"/>
                <decoder address="201" outputvalue="0"/>
                <decoder address="202" outputvalue="1"/>
            </state>
            <state name="HS" description="Hilfssignal">
                <decoder address="203" outputvalue="1"/>
            </state>
            <state name="BS" description="besetzte Einfahrt">
                <decoder address="203" outputvalue="1"/>
            </state>
        </states>
    </accessory>
    <!-- Signal Typ SBB-N (Extended-Protokoll) --> 
    <accessory uid="a7b8c9d0-e1f2-4a3b-5c6d-7e8f9a0b1c2d" type="signal" subtype="SBB-N" name="S11" interlocking="Bi">
        <decoder>
            <protocol>DCC</protocol>
        </decoder>
        <states>
            <state name="Halt" description="Halt (rot)">
                <decoder address="300" outputvalue="0"/>
            </state>
            <state name="Freie Fahrt" description="freie Fahrt (grün)">
                <decoder address="300" outputvalue="1"/>
            </state>
            <state name="Ausf60" description="Ausführung 60 km/h (grün mit Anzeige 6)">
                <decoder address="300" outputvalue="2"/>
            </state>
            <state name="Warnung" description="Warnung (orange)">
                <decoder address="300" outputvalue="3"/>
            </state>
            <state name="Vorwarnung" description="Vorwarnung (orange mit Anzeige V)">
                <decoder address="300" outputvalue="4"/>
            </state>
            <state name="Ank60" description="Ankündigung 60 km/h (orange mit Anzeige 6)">
                <decoder address="300" outputvalue="6"/>
            </state>
            <state name="Hilfssignal" description="Hilfssignal (rot blinkend)">
                <decoder address="300" outputvalue="7"/>
            </state>
        </states>
    </accessory>
</accessories>
