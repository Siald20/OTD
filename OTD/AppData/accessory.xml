<?xml version="1.0" encoding="utf-8"?>
<!-- Definition of Switching Devices like Turnouts and Signals -->
<accessories>
    <!-- Normale Weiche mit einem Antrieb (Basis-Protokoll, Aktivierungszeit 500 ms) -->
    <accessory uid="3f8a1b2c-4d5e-4f7a-8b9c-0d1e2f3a4b5c" type="turnout" subtype="right" interlocking="Bi" id="W1" >
        <decoder>
            <protocol>DCC</protocol>
            <activationtime>500</activationtime>
        </decoder>
        <states>
            <state id="straight" description="gerade">
                <decoder address="24" outputvalue="0" />
            </state>
            <state id="diverging" description="abzweigend">
                <decoder address="24" outputvalue="1"/>
            </state>
        </states>
    </accessory>
    <!-- Doppelkreuzungsweiche mit zwei Antrieben (Basis-Protokoll, Aktivierungszeit 500 ms, Pause zwischen Schaltvorgängen 1000 ms) -->
    <accessory uid="4a9b2c3d-5e6f-4a7b-9c0d-1e2f3a4b5c6d" type="turnout" subtype="double-slip" interlocking="Bi" id="W2" >
        <decoder>
            <protocol>DCC</protocol>
            <activationtime>500</activationtime>
            <delaytime>1000</delaytime>
        </decoder>
        <states>
            <state id="straight" description="gerade über Hauptgleis">
                <decoder address="9" outputvalue="1"/>
                <decoder address="10" outputvalue="1"/>
            </state>
            <state id="straight-crossing" description="abzweigend vom Hauptgleis auf überkreuzendes Gleis">
                <decoder address="9" outputvalue="1"/>
                <decoder address="10" outputvalue="0"/>
            </state>
            <state id="crossing" description="gerade über überkreuzendes Gleis">
                <decoder address="9" outputvalue="0"/>
                <decoder address="10" outputvalue="0"/>
            </state>
            <state id="crossing-straight" description="abzweigend vom überkreuzendem Gleis auf Hauptgleis">
                <decoder address="9" outputvalue="0"/>
                <decoder address="10" outputvalue="1"/>
            </state>
        </states>
    </accessory>
    <!-- Dreiwegweiche mit zwei Antrieben (Basis-Protokoll, Aktivierungszeit 500 ms, keine Pause zwischen Schaltvorgängen) -->
    <accessory uid="5b0c3d4e-6f7a-4b8c-9d0e-2f3a4b5c6d7e" type="turnout" subtype="three-way" id="W3" interlocking="Bi">
        <decoder>
            <protocol>DCC</protocol>
            <activationtime>500</activationtime>
        </decoder>
        <states>
            <state id="straight" description="gerade">
                <decoder address="13" outputvalue="0"/>
                <decoder address="14" outputvalue="0"/>
            </state>
            <state id="left" description="abzweigend nach links">
                <decoder address="13" outputvalue="1"/>
                <decoder address="14" outputvalue="0"/>
            </state>
            <state id="right" description="abzweigend nach rechts">
                <decoder address="13" outputvalue="0"/>
                <decoder address="14" outputvalue="1"/>
            </state>
        </states>
    </accessory>
    <!-- Signal Typ SBB-L (Basis-Protokoll, Aktivierungszeit 500 ms, keine Pause zwischen Schaltvorgängen) -->
    <accessory uid="b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d5e" type="signal" subtype="SBB-L" id="S1" interlocking="Bi" >
        <model>
            <signalsystem>SBB-L</signalsystem>
            <notes>Hauptsignal SBB Typ L</notes>
        </model>
        <decoder>
            <protocol>DCC</protocol>
        </decoder>
        <states>
            <state id="Halt" description="Halt">
                <decoder address="20" outputvalue="0"/>
                <decoder address="51" outputvalue="0"/>
                <decoder address="52" outputvalue="0"/>
            </state>
            <state id="Im1" description="Freie Fahrt">
                <decoder address="50" outputvalue="1"/>
                <decoder address="51" outputvalue="0"/>
                <decoder address="52" outputvalue="0"/>
            </state>
            <state id="Im2" description="Fahrbegriff 2 (40 km/h)">
                <decoder address="50" outputvalue="1"/>
                <decoder address="51" outputvalue="1"/>
                <decoder address="52" outputvalue="0"/>
            </state>
            <state id="HS" description="Hilfssignal">
                <decoder address="53" outputvalue="1"/>
            </state>
            <state id="BS" description="besetzte Einfahrt">
                <decoder address="54" outputvalue="1"/>
            </state>
        </states>
    </accessory>
    <!-- Signal Typ SBB-N (Extended-Protokoll) --> 
    <accessory uid="a7b8c9d0-e1f2-4a3b-5c6d-7e8f9a0b1c2d" type="signal" subtype="SBB-N" id="S11" interlocking="Bi">
        <decoder>
            <protocol>DCC</protocol>
        </decoder>
        <states>
            <state id="Halt" description="Halt (rot)">
                <decoder address="200" outputvalue="0"/>
            </state>
            <state id="Freie Fahrt" description="freie Fahrt (grün)">
                <decoder address="200" outputvalue="1"/>
            </state>
            <state id="Ausf60" description="Ausführung 60 km/h (grün mit Anzeige 6)">
                <decoder address="200" outputvalue="2"/>
            </state>
            <state id="Warnung" description="Warnung (orange)">
                <decoder address="200" outputvalue="3"/>
            </state>
            <state id="Vorwarnung" description="Vorwarnung (orange mit Anzeige V)">
                <decoder address="200" outputvalue="4"/>
            </state>
            <state id="Ank60" description="Ankündigung 60 km/h (orange mit Anzeige 6)">
                <decoder address="200" outputvalue="6"/>
            </state>
            <state id="Hilfssignal" description="Hilfssignal (rot blinkend)">
                <decoder address="200" outputvalue="7"/>
            </state>
        </states>
    </accessory>
</accessories>