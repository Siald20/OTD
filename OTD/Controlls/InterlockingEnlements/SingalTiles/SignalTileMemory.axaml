<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="120"
             x:Class="OTD.Controlls.InterlockingEnlements.SignalTileMemory">

    <UserControl.Styles>
        <StyleInclude Source="avares://OTD/Controlls/InterlockingEnlements/SingalTiles/Styles/SignalTilesStyles.axaml" />
        <Style Selector="Ellipse.memory-btn.blinking">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Ellipse.memory-btn.blinking-offphase">
            <Setter Property="Opacity" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Border Width="120" Height="120"
            Padding="0"
            BorderThickness="0"
            Background="Transparent">
        <Canvas Width="120"
                Height="120"
                UseLayoutRounding="True">
            <Border Canvas.Left="39" Canvas.Top="20" Background="#111" CornerRadius="8" Padding="7,4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource LampOff}"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SignalRed}"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SignalGreen}"/>
                </StackPanel>
            </Border>
            <Grid x:Name="MemoryGroup"
                  Canvas.Left="48"
                  Canvas.Top="45"
                  Width="28"
                  Height="28"
                  UseLayoutRounding="True">
                <Ellipse x:Name="StorageRing" Width="28" Height="28" Fill="Transparent" StrokeThickness="3"/>
                <Ellipse x:Name="MemoryButton"
                         Width="22"
                         Height="22"
                         Fill="#6B5600"
                         Classes="memory-btn"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="SignalNameText"
                       Canvas.Left="36" Canvas.Top="72" Width="48"
                       Text="xxx" TextAlignment="Center" FontWeight="Bold" />
        </Canvas>
    </Border>
</UserControl>
